# ============================================
# CONFIGURACIÓN CENTRALIZADA - EJEMPLO
# ============================================
# Copia este archivo como .env y ajusta los valores según tu entorno

# Nueva IP del servidor en producción (CAMBIAR ESTO)
PUBLIC_IP=TU_IP_PUBLICA_AQUI

# URLs Base (se generan automáticamente con PUBLIC_IP)
FRONTEND_URL=http://${PUBLIC_IP}:3000
OAUTH_URL=http://${PUBLIC_IP}:9000
GATEWAY_URL=http://${PUBLIC_IP}:8080

# Puertos de Servicios
GATEWAY_PORT=8080
OAUTH_PORT=9000
FRONTEND_PORT=3000
CATALOGO_PORT=8081
INVENTARIO_PORT=8082
VENTAS_PORT=8083

# Base de Datos MySQL
MYSQL_ROOT_PASSWORD=admin
MYSQL_HOST=mysql-db
MYSQL_PORT=3306

# Base de Datos PostgreSQL
POSTGRES_DB=db_oauth
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432

# URLs internas de microservicios (para comunicación entre contenedores)
CATALOGO_INTERNAL_URL=http://ms-catalogo:8081
INVENTARIO_INTERNAL_URL=http://ms-inventario:8082
VENTAS_INTERNAL_URL=http://ms-ventas:8083
OAUTH_INTERNAL_URL=http://oauth-server:9000
